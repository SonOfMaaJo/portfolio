---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 : page introuvable" includeSidebar={false}>
  <div class="text-center py-16">
    <p class="text-7xl md:text-8xl font-bold tracking-tight">404</p>
    <h1 class="text-2xl font-medium text-base-content/70 mt-4">
      La page que vous cherchez est introuvable.
    </h1>
    <a class="btn btn-primary mt-8" href="/">Retour à l'accueil</a>
  </div>
</BaseLayout>
