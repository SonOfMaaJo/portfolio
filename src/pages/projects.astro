---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../site_config";

const research = projects.filter((p) => p.type === "Recherche");
const school = projects.filter((p) => p.type === "42 Paris");
---

<BaseLayout title="Projets" sideBarActiveItemID="projects">
  <div class="mb-2">
    <h1 class="text-3xl font-bold tracking-tight">Projets</h1>
    <p class="mt-2 text-base-content/60">
      Architecture logicielle, programmation système et algorithmique.
    </p>
  </div>

  {
    research.length > 0 && (
      <>
        <h2 class="text-2xl font-bold tracking-tight mt-12 mb-6 pb-2 border-b border-base-300">
          Recherche
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {research.map((p) => (
            <a
              href={p.link}
              target="_blank"
              class="card bg-base-200 border border-base-300 hover:border-primary transition"
            >
              <div class="card-body">
                <div class="flex items-center gap-2">
                  <span class="badge badge-outline">{p.type}</span>
                  {p.status && <span class="badge badge-ghost">{p.status}</span>}
                </div>
                <h3 class="card-title">{p.title}</h3>
                <p class="text-base-content/80">{p.description}</p>
                <div class="flex flex-wrap gap-2 mt-2">
                  {p.tech.map((t) => (
                    <span class="badge badge-sm badge-outline">{t}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </>
    )
  }

  {
    school.length > 0 && (
      <>
        <h2 class="text-2xl font-bold tracking-tight mt-14 mb-6 pb-2 border-b border-base-300">
          École 42 Paris
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {school.map((p) => (
            <a
              href={p.link}
              target="_blank"
              class="card bg-base-200 border border-base-300 hover:border-primary transition"
            >
              <div class="card-body">
                <div class="flex items-center gap-2">
                  <span class="badge badge-outline">{p.type}</span>
                  {p.status && <span class="badge badge-ghost">{p.status}</span>}
                </div>
                <h3 class="card-title">{p.title}</h3>
                <p class="text-base-content/80">{p.description}</p>
                <div class="flex flex-wrap gap-2 mt-2">
                  {p.tech.map((t) => (
                    <span class="badge badge-sm badge-outline">{t}</span>
                  ))}
                </div>
              </div>
            </a>
          ))}
        </div>
      </>
    )
  }
</BaseLayout>
