---
import BaseLayout from "../layouts/BaseLayout.astro";
import { research, publications } from "../site_config";
---

<BaseLayout title="Recherche" sideBarActiveItemID="research">
  <div class="mb-2">
    <h1 class="text-3xl font-bold tracking-tight">Recherche</h1>
    <p class="mt-2 text-base-content/60">
      Modélisation mathématique et analyse économique appliquées aux réseaux de transport.
    </p>
  </div>

  <div class="card bg-base-200 border border-base-300 mt-10 mb-10">
    <div class="card-body">
      <span class="badge badge-outline">Projet en cours</span>
      <h2 class="card-title text-2xl tracking-tight">{research.title}</h2>
      <p class="text-base-content/60 italic">Co-écrit avec le {research.director}</p>
      <p class="mt-2 leading-relaxed">{research.description}</p>
      <div class="flex flex-wrap gap-2 mt-3">
        <span class="badge badge-outline">Gale-Shapley</span>
        <span class="badge badge-outline">Stable Matching</span>
        <span class="badge badge-outline">Equilibrium Theory</span>
        <span class="badge badge-outline">Île-de-France (large scale)</span>
      </div>
      <div class="card-actions mt-4">
        <a href={research.pdf} target="_blank" class="btn btn-sm btn-primary">Lire le draft (PDF)</a>
        <a href={research.code} target="_blank" class="btn btn-sm btn-outline">Code source (GitHub)</a>
      </div>
    </div>
  </div>

  <h2 class="text-2xl font-bold tracking-tight mt-14 mb-6 pb-2 border-b border-base-300">
    Publications
  </h2>
  <div class="flex flex-col gap-4">
    {
      publications.map((pub) => (
        <div class="card bg-base-200 border border-base-300 hover:border-primary transition">
          <div class="card-body flex-row gap-4 items-start">
            <span class="text-primary font-bold text-lg">{pub.year}</span>
            <div>
              <p class="font-bold">{pub.title}</p>
              <p class="text-base-content/60 italic text-sm my-1">{pub.journal}</p>
              <a href={pub.link} target="_blank" class="link link-primary text-sm font-semibold">
                DOI: {pub.doi}
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
